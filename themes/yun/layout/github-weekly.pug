extends _partial/layout.pug

block content
  - var weekly = page.weeklyData || (site.data && site.data.github_weekly) || {}
  - var archive = (site.data && site.data.github_weekly_archive) || { issues: [] }
  - var groups = Array.isArray(weekly.groups) ? weekly.groups : []
  - var projectCount = groups.reduce(function(total, group) { return total + ((group.projects && group.projects.length) || 0) }, 0)
  - var published = weekly.status === 'published' && projectCount > 0
  - var editionLabel = weekly.volume ? ('HG #' + weekly.volume) : 'AWAITING SIGNAL'
  script.
    document.body.classList.add('is-github-weekly-page')
  link(rel='stylesheet', href=url_for('/css/github-weekly.css'))
  #page.github-weekly.gw-page(data-week=weekly.week || '')
    header.gw-hero
      .gw-hero__signal(aria-hidden='true')
        span
        span
        span
      .gw-hero__copy
        p.gw-eyebrow SEVENTH KNOT / HELLOGITHUB MIRROR
        h1 HelloGitHub 最新一期
        p.gw-intro 同步 HelloGitHub 每月发布的开源项目月刊，不再调用 AI 生成介绍。
      .gw-hero__edition
        small= editionLabel
        strong= weekly.week || '等待月刊'
        if weekly.date
          time(datetime=weekly.date)= weekly.date

    if published
      section.gw-console(aria-label='周报概览')
        .gw-console__metric
          span 本期项目
          strong= projectCount
        .gw-console__metric
          span 数据来源
          strong HelloGitHub API
        .gw-console__metric
          span 内容语言
          strong 中文
        .gw-console__status
          i(aria-hidden='true')
          span 扫描完成

      section.gw-controls(aria-label='项目筛选')
        label.gw-search
          +icon('ri:search-line')
          span.sr-only 搜索项目
          input#github-weekly-search(type='search', placeholder='搜索项目、语言或标签', autocomplete='off')
        nav.gw-filters(aria-label='项目分类')
          button.is-active(type='button', data-weekly-filter='all', aria-pressed='true') 全部
          each group in groups
            button(type='button', data-weekly-filter=group.key, aria-pressed='false')= group.name
      p#github-weekly-status.gw-status= '正在显示全部 ' + projectCount + ' 个项目'

      section.gw-grid(aria-label='本期项目')
        each group in groups
          each project in group.projects
            - var tags = Array.isArray(project.tags) ? project.tags : []
            - var searchText = [project.name, project.repo, project.desc, project.language].concat(tags).filter(Boolean).join(' ')
            article.gw-card(data-weekly-category=group.key, data-weekly-search=searchText)
              .gw-card__top
                .gw-card__identity
                  if project.avatar
                    img(src=project.avatar, alt='', loading='lazy', referrerpolicy='no-referrer')
                  else
                    span(aria-hidden='true') GH
                  div
                    small= group.name
                    h2= project.name
                if project.weeklyStars
                  span.gw-card__trend
                    +icon('ri:arrow-up-line')
                    = project.weeklyStars.toLocaleString('zh-CN') + ' / 周'
              a.gw-card__repo(href=project.url, target='_blank', rel='noopener')
                span= project.repo
                +icon('ri:external-link-line')
              p.gw-card__description= project.desc
              if project.highlights && project.highlights.length
                ul.gw-card__highlights
                  each highlight in project.highlights
                    li= highlight
              if project.reason
                p.gw-card__reason
                  strong 推荐理由
                  span= project.reason
              .gw-card__tags
                if project.language
                  span= project.language
                each tag in tags
                  span= tag
              footer.gw-card__footer
                span
                  +icon('ri:star-fill')
                  = Number(project.stars || 0).toLocaleString('zh-CN')
                span
                  +icon('ri:git-fork-line')
                  = Number(project.forks || 0).toLocaleString('zh-CN')
                if project.license
                  span= project.license
      .gw-empty#github-weekly-empty(hidden)
        strong 没有找到匹配的项目
        p 换一个关键词或分类试试。
    else
      section.gw-awaiting
        .gw-awaiting__radar(aria-hidden='true')
          span
        div
          p SYSTEM STANDBY
          h2 HelloGitHub 月刊尚未同步
          p 运行同步命令后，这里会自动显示官方最新一期。
          code npm run hellogithub:update

    if archive.issues && archive.issues.length
      section.gw-archive
        header
          p ARCHIVE LOG
          h2 历史月刊
        nav(aria-label='历史月刊')
          each item in archive.issues
            - var active = weekly.week === item.week
            a(class=active ? 'is-active' : '', href=url_for(item.path))
              strong= '#' + item.issue
              span= item.week
              small= item.projectCount + ' 个项目'

    footer.gw-source
      p
        | 项目资料与中文介绍同步自 HelloGitHub，未做 AI 改写；内容依　
        a(href=weekly.licenseUrl || 'https://creativecommons.org/licenses/by-nc-nd/4.0/deed.zh-hans', target='_blank', rel='license noopener') CC BY-NC-ND 4.0
        | 　许可转载，请以官方页面为准。
      a(href=weekly.sourceUrl || 'https://hellogithub.com/periodical', target='_blank', rel='noopener')
        span 查看 HelloGitHub 原文
        +icon('ri:external-link-line')
  script(src=url_for('/js/github-weekly.js'), defer)
