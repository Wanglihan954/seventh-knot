mixin page_header(title, icon, color)
  header.post-header
    h1.post-title(itemprop='name headline', style=color ? `color: ${color}` : '')
      if page.title_icon === 'bangboo'
        span.page-title-icon.bangboo-icon(aria-hidden='true')
      else if page.title_image
        img.page-title-image(src=url_for(page.title_image), alt='', aria-hidden='true', width='40', height='40')
      else
        if page.icon
          - icon = page.icon
        if icon
          +icon(icon)
      !=title
